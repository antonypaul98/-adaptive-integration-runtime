+from copy import deepcopy
+import json
+from uuid import uuid4
+
+import pytest
+
+from air import sandbox as sb
+from air import repair_proposal as rp
+from test_repair_proposal import context, make, decide, description
+
+
+def run(tx, p, fixture, impact, **changes):
+    args = dict(proposal_hash=p['content_hash'], revision=json.loads(p['payload'])['revision'], current_impact_id=impact['artifact_id'])
+    args.update(changes)
+    return sb.evaluate(tx, p['artifact_id'], fixture['artifact_id'], **args)
+
+
+def test_deterministic_mutation_safe_and_failed_verification():
+    base={'a':{'b':1}}; proposed={'field':'new_name'}; expected={**base,**proposed}
+    result=sb.simulate(base,expected,proposed)
+    assert result['execution_result']=='PASS'
+    assert sb.simulate(dict(reversed(list(base.items()))),expected,proposed)==result
+    result['output']['a']['b']=2
+    assert base=={'a':{'b':1}}
+    assert sb.simulate(base,{},proposed)['failure_reason']=='expected_state_mismatch'
+    assert sb.simulate(base,expected,proposed)['deployment_authorized'] is False
+
+
+@pytest.mark.parametrize('value',[None,[], 'code', {1:'bad'}, {'x':float('nan')}, {'x':1.5}, {'x':object()}, {'x':1<<257}, {'x':'a'*65537}, {'x':list(range(5000))}])
+def test_malformed_and_bounded(value):
+    with pytest.raises(sb.SandboxError): sb.simulate(value,{}, {})
+
+
+def test_depth_cycles_deadline(monkeypatch):
+    value={}; value['self']=value
+    with pytest.raises(sb.SandboxError,match='complexity_limit'): sb.bounded(value)
+    times=iter([0,2]); monkeypatch.setattr(sb.time,'monotonic',lambda:next(times))
+    with pytest.raises(sb.SandboxError,match='time_limit'): sb.bounded({})
+
+
+def test_evaluation_exact_provenance_idempotence_and_staleness(context):
+    tx,impact,_=context; p=make(context); decide(tx,p)
+    fixture=sb.register_input(tx,{},description()['proposed_state'])
+    result=run(tx,p,fixture,impact)
+    assert result==run(tx,p,fixture,impact)==sb.load_result(tx,result['artifact_id'])
+    body=json.loads(result['payload'])
+    assert body['proposal']==rp.reference(p) and body['input']==rp.reference(fixture)
+    assert body['result']['execution_result']=='PASS'
+    make(context,supersedes=p['artifact_id'])
+    with pytest.raises(rp.ProposalError): run(tx,p,fixture,impact)
+    with pytest.raises(rp.ProposalError): sb.load_result(tx,result['artifact_id'])
+
+
+@pytest.mark.parametrize('changes',[{'proposal_hash':'0'*64},{'revision':True},{'revision':2},{'current_impact_id':uuid4()}])
+def test_exact_binding(context,changes):
+    tx,impact,_=context;p=make(context);decide(tx,p);fixture=sb.register_input(tx,{}, {})
+    with pytest.raises(rp.ProposalError): run(tx,p,fixture,impact,**changes)
+
+
+@pytest.mark.parametrize('decision',[None,'REJECTED'])
+def test_approval_required(context,decision):
+    tx,impact,_=context;p=make(context);fixture=sb.register_input(tx,{}, {})
+    if decision: decide(tx,p,decision)
+    with pytest.raises(rp.ProposalError): run(tx,p,fixture,impact)
+
+
+@pytest.mark.parametrize('kind',['proposal','input','result'])
+def test_foreign_and_forged_records(context,kind):
+    tx,impact,_=context;p=make(context);decide(tx,p);fixture=sb.register_input(tx,{}, {})
+    result=run(tx,p,fixture,impact)
+    record={'proposal':p,'input':fixture,'result':result}[kind]
+    record['tenant_id']=uuid4()
+    with pytest.raises(rp.ProposalError): sb.load_result(tx,result['artifact_id'])
+
+
+@pytest.mark.parametrize('field',['result','input','environment','revision','extra'])
+def test_forged_result_even_rehashed(context,field):
+    tx,impact,_=context;p=make(context);decide(tx,p);fixture=sb.register_input(tx,{}, {})
+    result=run(tx,p,fixture,impact);body=json.loads(result['payload']);body[field]=None
+    result['payload']=sb.canonical_json(body);result['content_hash']=rp.digest(body);result['idempotency_key']=rp.digest(body)
+    with pytest.raises((ValueError,TypeError)): sb.load_result(tx,result['artifact_id'])
